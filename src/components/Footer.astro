---
const today = new Date();
import { SITE_TITLE } from "../consts";
---

<footer>
	<div class="footer-brand">
		<img
			src="/logo.png"
			alt="ResizeForge Logo"
			class="footer-logo-img"
			width="32"
			height="32"
		/>
		<span class="footer-title">{SITE_TITLE}</span>
	</div>
	<p class="copyright">
		&copy; {today.getFullYear()} ResizeForge. All rights reserved.
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 2em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5em;
	}
	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}
	.footer-logo-img {
		height: 32px;
		width: 32px;
		max-height: 32px;
		max-width: 32px;
		object-fit: contain;
		display: block;
	}
	.footer-title {
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-main, #0f172a);
	}
	.copyright {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-muted, #64748b);
	}
</style>
