---
interface Props {
	label?: string;
}

const { label = "728 × 90 Top Banner" } = Astro.props;
---

<div class="ad-top-wrapper">
	<div class="ad-placeholder ad-top">
		<span class="ad-tag">ADVERTISEMENT</span>
		<span class="ad-size">{label}</span>
	</div>
</div>

<style>
	.ad-top-wrapper {
		display: flex;
		justify-content: center;
		margin-bottom: 1.25em;
		width: 100%;
	}

	.ad-placeholder {
		background: #f8fafc;
		border: 2px dashed #cbd5e1;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: #94a3b8;
		font-family:
			system-ui,
			-apple-system,
			sans-serif;
		text-align: center;
		padding: 0.5em;
		user-select: none;
		box-sizing: border-box;
	}

	.ad-placeholder .ad-tag {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: #94a3b8;
	}

	.ad-placeholder .ad-size {
		font-size: 0.8rem;
		font-weight: 500;
		color: #cbd5e1;
		margin-top: 0.2em;
	}

	.ad-top {
		width: 100%;
		max-width: 728px;
		height: 90px;
	}

	@media (max-width: 640px) {
		.ad-top {
			height: 60px;
		}
	}
</style>
