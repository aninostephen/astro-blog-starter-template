---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
	<nav>
		<h2>
			<a href="/" class="logo-link">
				<img
					src="/logo.png"
					alt="ResizeForge Logo"
					class="site-logo"
					width="26"
					height="26"
				/>
				<span class="brand-name">ResizeForge</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Resizer</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<div class="bmc-wrapper">
				<script
					is:inline
					type="text/javascript"
					src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
					data-name="bmc-button"
					data-slug="aninostephen"
					data-color="#5F7FFF"
					data-emoji="☕"
					data-font="Cookie"
					data-text="Buy me a coffee"
					data-outline-color="#000000"
					data-font-color="#ffffff"
					data-coffee-color="#FFDD00"
				></script>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 1000;
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 0.95em;
	}

	.logo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		padding: 0.25em 0;
		border-bottom: none !important;
	}
	.site-logo {
		height: 26px;
		width: 26px;
		max-height: 26px;
		max-width: 26px;
		object-fit: contain;
		display: block;
	}
	.brand-name {
		font-weight: 700;
		font-size: 1.1rem;
		color: #0f172a;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25em 0.5em;
	}
	.internal-links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.25em;
	}
	nav a {
		padding: 0.3em 0.5em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.bmc-wrapper {
		display: inline-flex;
		align-items: center;
		margin-left: 0.4em;
	}
	.bmc-wrapper :global(.bmc-btn-container) {
		display: inline-flex;
		align-items: center;
	}
	.bmc-wrapper :global(.bmc-btn) {
		height: 36px !important;
		min-width: unset !important;
		padding: 0 12px !important;
		font-size: 21px !important;
		line-height: 1 !important;
		border-radius: 8px !important;
		color: #ffffff !important;
	}
	.bmc-wrapper :global(.bmc-btn:hover) {
		color: #ffffff !important;
	}
	.bmc-wrapper :global(.bmc-btn-text) {
		font-size: 21px !important;
		line-height: 1 !important;
	}
	.bmc-wrapper :global(.bmc-btn svg) {
		height: 20px !important;
		width: auto !important;
	}
</style>
