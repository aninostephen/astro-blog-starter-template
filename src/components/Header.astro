---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header>
	<nav>
		<h2>
			<a href="/" class="logo-link">
				<img
					src="/logo.png"
					alt="ResizeForge Logo"
					class="site-logo"
					width="26"
					height="26"
				/>
				<span class="brand-name">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Resizer</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 0.95em;
	}

	.logo-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		padding: 0.25em 0;
		border-bottom: none !important;
	}
	.site-logo {
		height: 26px;
		width: 26px;
		max-height: 26px;
		max-width: 26px;
		object-fit: contain;
		display: block;
	}
	.brand-name {
		font-weight: 700;
		font-size: 1.1rem;
		color: #0f172a;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 0.3em 0.5em;
		color: var(--black);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
