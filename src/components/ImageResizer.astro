	/* Preview Panel */
	.preview-stage {
		flex: 1;
		min-height: 260px;
		background: #0f172a;
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		position: relative;
		background-image: radial-gradient(#334155 1px, transparent 1px);
		background-size: 16px 16px;
