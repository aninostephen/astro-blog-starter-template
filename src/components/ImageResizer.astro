	/* Summary Cards */
	.summary-cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75em;
	}

	.summary-card {
		background: #f8fafc;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-sm);
		padding: 0.75em 0.5em;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.summary-label {
		font-size: 0.75rem;
		color: var(--text-muted);
		text-transform: uppercase;
		font-weight: 600;
	}

	.summary-value {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--text-main);
	}

	/* Crop Controls & Presets */
	.resize-controls,
	.crop-controls {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	.crop-presets-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(75px, 1fr));
		gap: 0.5em;
	}

	.crop-preset-btn {
		background: #f8fafc;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-sm);
		padding: 0.5em 0.25em;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
		color: var(--text-main);
	}

	.crop-preset-btn:hover {
		background: #f1f5f9;
		border-color: #cbd5e1;
	}

	.crop-preset-btn.active {
		background: #e0e7ff;
		border-color: var(--accent-color);
		color: var(--accent-color);
		font-weight: 700;
	}

	.crop-preset-btn .preset-name {
		font-size: 0.85rem;
		font-weight: 600;
	}

	.crop-preset-btn .preset-sub {
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	.crop-preset-btn.active .preset-sub {
		color: var(--accent-color);
	}

	.crop-dims-card {
		display: flex;
		align-items: center;
		justify-content: space-around;
		background: #f8fafc;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-sm);
		padding: 0.75em 0.5em;
	}

	.crop-dim-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2em;
	}

	.crop-dim-label {
		font-size: 0.72rem;
		color: var(--text-muted);
		text-transform: uppercase;
		font-weight: 600;
	}

	.crop-dim-val {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text-main);
	}

	.crop-dim-divider {
		font-size: 1.1rem;
		color: var(--text-muted);
		font-weight: 300;
	}

	.crop-helper-hint {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0.2em 0 0;
		line-height: 1.4;
	}

	.crop-actions-group {
		display: flex;
		gap: 0.5em;
		margin-top: 0.5em;
	}

	/* Crop Stage */
	.crop-stage {
		flex: 1;
		min-height: 280px;
		max-height: 420px;
		background: #0f172a;
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		position: relative;
	}

	.cropper-wrapper {
		width: 100%;
		height: 100%;
		max-height: 420px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cropper-wrapper img {
		display: block;
		max-width: 100%;
		max-height: 400px;
	}

	/* Cropper.js visual theme overrides */
	.crop-stage :global(.cropper-container) {
		width: 100% !important;
		height: 100% !important;
		max-height: 420px !important;
	}

	.crop-stage :global(.cropper-view-box) {
		outline: 2px solid #6366f1 !important;
	}

	.crop-stage :global(.cropper-line) {
		background-color: #6366f1 !important;
	}

	.crop-stage :global(.cropper-point) {
		background-color: #6366f1 !important;
		width: 8px !important;
		height: 8px !important;
		border-radius: 2px !important;
	}

	.crop-stage :global(.cropper-point.point-se) {
		width: 11px !important;
		height: 11px !important;
	}
</style>

<script>
	import Cropper from 'cropperjs';

	// Image Resizer Client-side Logic
	document.addEventListener('DOMContentLoaded', () => {
		const dropzone = document.getElementById('dropzone') as HTMLDivElement;
		const fileInput = document.getElementById('file-input') as HTMLInputElement;
		const workspace = document.getElementById('workspace') as HTMLDivElement;

		const fileNameEl = document.getElementById('file-name') as HTMLHeadingElement;
		const originalMetaEl = document.getElementById('original-meta') as HTMLParagraphElement;
		const changeImageBtn = document.getElementById('change-image-btn') as HTMLButtonElement;
		const openCropBtn = document.getElementById('open-crop-btn') as HTMLButtonElement;
		const revertOriginalBtn = document.getElementById('revert-original-btn') as HTMLButtonElement;

		const resizeControls = document.getElementById('resize-controls') as HTMLDivElement;
		const cropControls = document.getElementById('crop-controls') as HTMLDivElement;
		const cropPresetBtns = document.querySelectorAll('.crop-preset-btn') as NodeListOf<HTMLButtonElement>;
		const cropBoxW = document.getElementById('crop-box-w') as HTMLSpanElement;
		const cropBoxH = document.getElementById('crop-box-h') as HTMLSpanElement;
		const cropBoxRatio = document.getElementById('crop-box-ratio') as HTMLSpanElement;
		const cancelCropBtn = document.getElementById('cancel-crop-btn') as HTMLButtonElement;
		const resetCropBoxBtn = document.getElementById('reset-crop-box-btn') as HTMLButtonElement;
		const applyCropBtn = document.getElementById('apply-crop-btn') as HTMLButtonElement;

		const previewPanelTitle = document.getElementById('preview-panel-title') as HTMLHeadingElement;
		const previewStage = document.getElementById('preview-stage') as HTMLDivElement;
		const cropStage = document.getElementById('crop-stage') as HTMLDivElement;
		const cropperImg = document.getElementById('cropper-img') as HTMLImageElement;
		const summaryCards = document.getElementById('summary-cards') as HTMLDivElement;

		const widthInput = document.getElementById('width-input') as HTMLInputElement;
		const heightInput = document.getElementById('height-input') as HTMLInputElement;
		const lockAspectBtn = document.getElementById('lock-aspect-btn') as HTMLButtonElement;
		const lockIcon = document.querySelector('#lock-icon') as SVGElement;
		const unlockIcon = document.querySelector('#unlock-icon') as SVGElement;

		const enlargeToggle = document.getElementById('enlarge-toggle') as HTMLInputElement;
		const presetBtns = document.querySelectorAll('.preset-btn') as NodeListOf<HTMLButtonElement>;

		const formatSelect = document.getElementById('format-select') as unknown as HTMLSelectElement;
		const qualityContainer = document.getElementById('quality-container') as HTMLDivElement;
		const qualityRange = document.getElementById('quality-range') as HTMLInputElement;
		const qualityVal = document.getElementById('quality-val') as HTMLSpanElement;

		const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
		const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;

		const previewImg = document.getElementById('preview-img') as HTMLImageElement;
		const previewLoader = document.getElementById('preview-loader') as HTMLDivElement;
		const targetDimensionsBadge = document.getElementById('target-dimensions-badge') as HTMLSpanElement;
		const targetRatioBadge = document.getElementById('target-ratio-badge') as HTMLSpanElement;
		const targetSizeBadge = document.getElementById('target-size-badge') as HTMLSpanElement;

		const canvas = document.getElementById('process-canvas') as HTMLCanvasElement;
		const ctx = canvas.getContext('2d');

		// State Variables
		let loadedImage: HTMLImageElement | null = null;
		let initialOriginalImage: HTMLImageElement | null = null;
		let initialOriginalWidth = 0;
		let initialOriginalHeight = 0;
		let initialOriginalFileSize = 0;
		let cropperInstance: Cropper | null = null;

		let originalWidth = 0;
		let originalHeight = 0;
		let originalAspectRatio = 1;
		let originalFileName = 'image.png';
		let originalFileSize = 0;
		let isAspectLocked = true;

		// Utility: format file size
		function formatBytes(bytes: number): string {
			if (bytes === 0) return '0 Bytes';
			const k = 1024;
			const sizes = ['Bytes', 'KB', 'MB', 'GB'];
			const i = Math.floor(Math.log(bytes) / Math.log(k));
			return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
		}

		// Drag and Drop handlers
		['dragenter', 'dragover'].forEach(eventName => {
			dropzone.addEventListener(eventName, (e) => {
				e.preventDefault();
				e.stopPropagation();
				dropzone.classList.add('drag-over');
			});
		});

		['dragleave', 'drop'].forEach(eventName => {
			dropzone.addEventListener(eventName, (e) => {
				e.preventDefault();
				e.stopPropagation();
				dropzone.classList.remove('drag-over');
			});
		});

		dropzone.addEventListener('drop', (e) => {
			const files = e.dataTransfer?.files;
			if (files && files.length > 0) {
				handleFileSelect(files[0]);
			}
		});

		fileInput.addEventListener('change', (e) => {
			const target = e.target as HTMLInputElement;
			if (target.files && target.files.length > 0) {
				handleFileSelect(target.files[0]);
			}
		});

		changeImageBtn.addEventListener('click', () => {
			exitCropMode();
			fileInput.value = '';
			workspace.classList.add('hidden');
			dropzone.classList.remove('hidden');
			revertOriginalBtn.classList.add('hidden');
			initialOriginalImage = null;
		});

		// File load handler
		function handleFileSelect(file: File) {
			if (!file.type.startsWith('image/')) {
				alert('Please upload a valid image file.');
				return;
			}

			originalFileName = file.name;
			originalFileSize = file.size;

			const reader = new FileReader();
			reader.onload = (event) => {
				const img = new Image();
				img.onload = () => {
					loadedImage = img;
					initialOriginalImage = img;
					initialOriginalWidth = img.width;
					initialOriginalHeight = img.height;
					initialOriginalFileSize = file.size;

					originalWidth = img.width;
					originalHeight = img.height;
					originalAspectRatio = originalWidth / originalHeight;

					// Update File Info
					fileNameEl.textContent = originalFileName;
					originalMetaEl.textContent = `${originalWidth} × ${originalHeight} px • ${formatBytes(originalFileSize)}`;
					revertOriginalBtn.classList.add('hidden');

					// Populate inputs
					widthInput.value = originalWidth.toString();
					heightInput.value = originalHeight.toString();

					// Show workspace
					exitCropMode();
					dropzone.classList.add('hidden');
					workspace.classList.remove('hidden');

					updateEnlargePresetStates();
					updatePreview();
				};
				img.src = event.target?.result as string;
			};
			reader.readAsDataURL(file);
		}

		// Crop Mode Handlers
		function enterCropMode() {
			if (!loadedImage) return;

			resizeControls.classList.add('hidden');
			cropControls.classList.remove('hidden');
			previewStage.classList.add('hidden');
			cropStage.classList.remove('hidden');
			summaryCards.classList.add('hidden');
			previewPanelTitle.textContent = 'Crop Image';

			// Reset presets to freeform
			cropPresetBtns.forEach(b => b.classList.toggle('active', b.dataset.ratio === 'free'));

			cropperImg.src = loadedImage.src;

			const initCropper = () => {
				if (cropperInstance) {
					cropperInstance.destroy();
					cropperInstance = null;
				}

				cropperInstance = new Cropper(cropperImg, {
					viewMode: 1,
					dragMode: 'crop',
					aspectRatio: NaN,
					autoCropArea: 0.9,
					restore: false,
					guides: true,
					center: true,
					highlight: true,
					cropBoxMovable: true,
					cropBoxResizable: true,
					toggleDragModeOnDblclick: false,
					crop(event) {
						const data = event.detail;
						const w = Math.round(data.width);
						const h = Math.round(data.height);
						cropBoxW.textContent = `${w} px`;
						cropBoxH.textContent = `${h} px`;
						if (w > 0 && h > 0) {
							const gcdVal = gcd(w, h);
							const rw = Math.round(w / gcdVal);
							const rh = Math.round(h / gcdVal);
							cropBoxRatio.textContent = (rw < 50 && rh < 50) ? `${rw}:${rh}` : `${(w / h).toFixed(2)}:1`;
						}
					}
				});
			};

			if (cropperImg.complete) {
				initCropper();
			} else {
				cropperImg.onload = initCropper;
			}
		}

		function exitCropMode() {
			if (cropperInstance) {
				cropperInstance.destroy();
				cropperInstance = null;
			}
			cropControls.classList.add('hidden');
			resizeControls.classList.remove('hidden');
			cropStage.classList.add('hidden');
			previewStage.classList.remove('hidden');
			summaryCards.classList.remove('hidden');
			previewPanelTitle.textContent = 'Preview';
		}

		openCropBtn.addEventListener('click', enterCropMode);

		cancelCropBtn.addEventListener('click', exitCropMode);

		resetCropBoxBtn.addEventListener('click', () => {
			cropperInstance?.reset();
		});

		cropPresetBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				cropPresetBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');

				if (!cropperInstance) return;

				const ratio = btn.dataset.ratio;
				switch (ratio) {
					case '1:1':
						cropperInstance.setAspectRatio(1);
						break;
					case '4:5':
						cropperInstance.setAspectRatio(4 / 5);
						break;
					case '16:9':
						cropperInstance.setAspectRatio(16 / 9);
						break;
					case '9:16':
						cropperInstance.setAspectRatio(9 / 16);
						break;
					case '4:3':
						cropperInstance.setAspectRatio(4 / 3);
						break;
					case '3:2':
						cropperInstance.setAspectRatio(3 / 2);
						break;
					case 'free':
					default:
						cropperInstance.setAspectRatio(NaN);
						break;
				}
			});
		});

		applyCropBtn.addEventListener('click', () => {
			if (!cropperInstance) return;

			const croppedCanvas = cropperInstance.getCroppedCanvas({
				imageSmoothingEnabled: true,
				imageSmoothingQuality: 'high',
			});

			if (!croppedCanvas) return;

			const mimeType = formatSelect.value || 'image/png';
			const quality = parseInt(qualityRange.value) / 100;
			const croppedDataUrl = croppedCanvas.toDataURL(mimeType, quality);

			exitCropMode();

			const croppedImg = new Image();
			croppedImg.onload = () => {
				loadedImage = croppedImg;
				originalWidth = croppedImg.width;
				originalHeight = croppedImg.height;
				originalAspectRatio = originalWidth / originalHeight;

				originalMetaEl.textContent = `${originalWidth} × ${originalHeight} px • Cropped`;
				revertOriginalBtn.classList.remove('hidden');

				widthInput.value = originalWidth.toString();
				heightInput.value = originalHeight.toString();

				updateEnlargePresetStates();
				updateActivePresetButton();
				updatePreview();
			};
			croppedImg.src = croppedDataUrl;
		});

		revertOriginalBtn.addEventListener('click', () => {
			if (!initialOriginalImage) return;

			loadedImage = initialOriginalImage;
			originalWidth = initialOriginalWidth;
			originalHeight = initialOriginalHeight;
			originalAspectRatio = originalWidth / originalHeight;

			originalMetaEl.textContent = `${originalWidth} × ${originalHeight} px • ${formatBytes(initialOriginalFileSize)}`;
			revertOriginalBtn.classList.add('hidden');

			widthInput.value = originalWidth.toString();
			heightInput.value = originalHeight.toString();

			updateEnlargePresetStates();
			updateActivePresetButton();
			updatePreview();
		});

		// Aspect Ratio Lock Toggle
		lockAspectBtn.addEventListener('click', () => {
			isAspectLocked = !isAspectLocked;
			lockAspectBtn.classList.toggle('active', isAspectLocked);
			lockIcon.classList.toggle('hidden', !isAspectLocked);
			unlockIcon.classList.toggle('hidden', isAspectLocked);

			if (isAspectLocked && loadedImage) {
				// Re-sync height based on current width
				syncHeightFromWidth();
				updatePreview();
			}
		});

		// Dimension Input Handlers
		widthInput.addEventListener('input', () => {
			enforceMaxDimensionsIfNeeded('width');
			if (isAspectLocked) {
				syncHeightFromWidth();
			}
			updateActivePresetButton();
			updatePreview();
		});

		heightInput.addEventListener('input', () => {
			enforceMaxDimensionsIfNeeded('height');
			if (isAspectLocked) {
				syncWidthFromHeight();
			}
			updateActivePresetButton();
			updatePreview();
		});

		// Helper to sync dimensions
		function syncHeightFromWidth() {
			const currentWidth = parseInt(widthInput.value) || 0;
			if (currentWidth > 0 && originalAspectRatio > 0) {
				let calcHeight = Math.round(currentWidth / originalAspectRatio);
				if (enlargeToggle.checked && calcHeight > originalHeight) {
					calcHeight = originalHeight;
				}
				heightInput.value = calcHeight.toString();
			}
		}

		function syncWidthFromHeight() {
			const currentHeight = parseInt(heightInput.value) || 0;
			if (currentHeight > 0 && originalAspectRatio > 0) {
				let calcWidth = Math.round(currentHeight * originalAspectRatio);
				if (enlargeToggle.checked && calcWidth > originalWidth) {
					calcWidth = originalWidth;
				}
				widthInput.value = calcWidth.toString();
			}
		}

		// Enforce "Do Not Enlarge If Smaller" rule
		function enforceMaxDimensionsIfNeeded(changedSource: 'width' | 'height') {
			if (!enlargeToggle.checked) return;

			let currentW = parseInt(widthInput.value) || 0;
			let currentH = parseInt(heightInput.value) || 0;

			if (changedSource === 'width' && currentW > originalWidth) {
				widthInput.value = originalWidth.toString();
			} else if (changedSource === 'height' && currentH > originalHeight) {
				heightInput.value = originalHeight.toString();
			}
		}

		// Toggle "Do Not Enlarge" Listener
		enlargeToggle.addEventListener('change', () => {
			updateEnlargePresetStates();
			if (enlargeToggle.checked) {
				let currentW = parseInt(widthInput.value) || 0;
				let currentH = parseInt(heightInput.value) || 0;
				if (currentW > originalWidth || currentH > originalHeight) {
					widthInput.value = originalWidth.toString();
					if (isAspectLocked) {
						syncHeightFromWidth();
					} else if (currentH > originalHeight) {
						heightInput.value = originalHeight.toString();
					}
					updatePreview();
				}
			}
		});

		function updateEnlargePresetStates() {
			const doNotEnlarge = enlargeToggle.checked;
			presetBtns.forEach(btn => {
				const scale = parseFloat(btn.dataset.scale || '1');
				if (doNotEnlarge && scale > 1) {
					btn.disabled = true;
					btn.title = "Enlarging is disabled because 'Do not enlarge if smaller' is active";
				} else {
					btn.disabled = false;
					btn.title = "";
				}
			});
		}

		// Presets Handlers
		presetBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				if (btn.disabled) return;
				const scale = parseFloat(btn.dataset.scale || '1');

				presetBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');

				let targetW = Math.round(originalWidth * scale);
				let targetH = Math.round(originalHeight * scale);

				if (enlargeToggle.checked) {
					if (targetW > originalWidth) targetW = originalWidth;
					if (targetH > originalHeight) targetH = originalHeight;
				}

				widthInput.value = targetW.toString();
				heightInput.value = targetH.toString();
				updatePreview();
			});
		});

		function updateActivePresetButton() {
			const currentW = parseInt(widthInput.value) || 0;
			presetBtns.forEach(b => b.classList.remove('active'));
			if (originalWidth > 0) {
				const currentScale = currentW / originalWidth;
				presetBtns.forEach(btn => {
					const scale = parseFloat(btn.dataset.scale || '0');
					if (Math.abs(scale - currentScale) < 0.02) {
						btn.classList.add('active');
					}
				});
			}
		}

		// Format & Quality Controls
		formatSelect.addEventListener('change', () => {
			const val = formatSelect.value;
			if (val === 'image/jpeg' || val === 'image/webp') {
				qualityContainer.classList.remove('hidden');
			} else {
				qualityContainer.classList.add('hidden');
			}
			updatePreview();
		});

		qualityRange.addEventListener('input', () => {
			qualityVal.textContent = `${qualityRange.value}%`;
			updatePreview();
		});

		// Reset Button
		resetBtn.addEventListener('click', () => {
			widthInput.value = originalWidth.toString();
			heightInput.value = originalHeight.toString();
			isAspectLocked = true;
			lockAspectBtn.classList.add('active');
			lockIcon.classList.remove('hidden');
			unlockIcon.classList.add('hidden');
			enlargeToggle.checked = true;
			updateEnlargePresetStates();
			updateActivePresetButton();
			updatePreview();
		});

		// Live Preview & Render Logic
		let previewTimeout: number | undefined;

		function updatePreview() {
			if (!loadedImage || !ctx) return;

			const targetW = parseInt(widthInput.value) || 1;
			const targetH = parseInt(heightInput.value) || 1;

			// Update Badges
			targetDimensionsBadge.textContent = `${targetW} × ${targetH} px`;

			const gcdVal = gcd(targetW, targetH);
			const ratioW = Math.round(targetW / gcdVal);
			const ratioH = Math.round(targetH / gcdVal);
			targetRatioBadge.textContent = (ratioW < 100 && ratioH < 100) ? `${ratioW}:${ratioH}` : `${(targetW/targetH).toFixed(2)}:1`;

			// Show real-time loading state
			previewLoader?.classList.remove('hidden');
			targetSizeBadge.textContent = 'Updating...';

			// Debounce canvas rendering for smooth responsiveness
			window.clearTimeout(previewTimeout);
			previewTimeout = window.setTimeout(() => {
				renderCanvas(targetW, targetH, (blob) => {
					if (blob) {
						previewImg.src = URL.createObjectURL(blob);
						targetSizeBadge.textContent = formatBytes(blob.size);
					}
					previewLoader?.classList.add('hidden');
				});
			}, 100);
		}

		function gcd(a: number, b: number): number {
			return b === 0 ? a : gcd(b, a % b);
		}

		function renderCanvas(targetW: number, targetH: number, callback: (blob: Blob | null) => void) {
			if (!loadedImage || !ctx) return;

			canvas.width = targetW;
			canvas.height = targetH;

			ctx.imageSmoothingEnabled = true;
			ctx.imageSmoothingQuality = 'high';
			ctx.clearRect(0, 0, targetW, targetH);
			ctx.drawImage(loadedImage, 0, 0, targetW, targetH);

			const mimeType = formatSelect.value;
			const quality = parseInt(qualityRange.value) / 100;

			canvas.toBlob((blob) => {
				callback(blob);
			}, mimeType, quality);
		}

		// Download Handler
		downloadBtn.addEventListener('click', () => {
			if (!loadedImage) return;

			const targetW = parseInt(widthInput.value) || originalWidth;
			const targetH = parseInt(heightInput.value) || originalHeight;

			renderCanvas(targetW, targetH, (blob) => {
				if (!blob) return;

				const mimeType = formatSelect.value;
				let ext = 'png';
				if (mimeType === 'image/jpeg') ext = 'jpg';
				else if (mimeType === 'image/webp') ext = 'webp';

				const nameWithoutExt = originalFileName.substring(0, originalFileName.lastIndexOf('.')) || originalFileName;
				const downloadName = `${nameWithoutExt}_resized_${targetW}x${targetH}.${ext}`;

				const link = document.createElement('a');
				link.download = downloadName;
				link.href = URL.createObjectURL(blob);
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
			});
		});
	});
</script>
