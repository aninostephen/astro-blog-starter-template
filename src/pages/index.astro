---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ImageResizer from "../components/ImageResizer.astro";
import AdHorizontal from "../components/ads/AdHorizontal.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 1440px;
				margin: 0 auto;
				padding: 1.5em 1em;
			}

			.hero {
				text-align: center;
				margin-bottom: 1.25em;
			}

			.hero h1 {
				font-size: 2.2rem;
				font-weight: 800;
				color: #0f172a;
				margin-bottom: 0.2em;
				letter-spacing: -0.025em;
				line-height: 1.2;
			}

			.hero-highlight {
				background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}

			.hero p {
				font-size: 1.1rem;
				color: #475569;
				max-width: 600px;
				margin: 0.8em auto 0;
				line-height: 1.6;
			}

			/* Page Layout (Centered when vertical ads are disabled) */
			.page-layout {
				display: flex;
				justify-content: center;
				width: 100%;
			}

			.bottom-ads {
				margin-top: 3%;
			}

			.main-content {
				min-width: 0;
				width: 100%;
				max-width: 1050px;
			}

			@media (max-width: 640px) {
				.hero h1 {
					font-size: 1.6rem;
				}
				.hero p {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Top Horizontal Ad -->
			<AdHorizontal />

			<div class="hero">
				<h1>
					Resize Images <span class="hero-highlight">Instantly</span> in
					Your Browser
				</h1>
				<p>
					Resize JPG, PNG, WebP, GIF, SVG and BMP images directly in
					your browser. Resize images to custom dimensions without
					uploading your files to a server.
				</p>
			</div>

			<!-- Main Layout (AdVertical disabled/hidden) -->
			<div class="page-layout">
				<!-- <AdVertical show={true} /> -->

				<!-- Center Main Content -->
				<div class="main-content">
					<ImageResizer />
				</div>

				<!-- <AdVertical show={true} /> -->
			</div>

			<div class="bottom-ads">
				<AdHorizontal />
			</div>
		</main>
		<Footer />
	</body>
</html>
