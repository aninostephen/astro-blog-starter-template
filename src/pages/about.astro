---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em;
			}
			h1 {
				margin-bottom: 0.5em;
			}
			p {
				line-height: 1.6;
				color: var(--gray-dark, #333);
				margin-bottom: 1.5em;
			}
			ul {
				margin-bottom: 1.5em;
				padding-left: 1.25em;
			}
			li {
				margin-bottom: 0.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>About Image Resizer</h1>
			<p>
				Image Resizer is a fast, privacy-focused client-side tool designed to scale your images efficiently right inside your browser. None of your images are ever uploaded to a remote server.
			</p>
			<h2>Key Features</h2>
			<ul>
				<li><strong>Custom Width & Height:</strong> Precisely enter your target pixel dimensions.</li>
				<li><strong>Aspect Ratio Lock:</strong> Seamlessly adjust width or height while keeping your original image proportions intact.</li>
				<li><strong>Do Not Enlarge:</strong> Enable this setting to prevent small images from upscaling and losing visual quality.</li>
				<li><strong>Multiple Formats:</strong> Export resized images as PNG, JPEG, or WebP with customizable compression quality.</li>
				<li><strong>Instant Browser Processing:</strong> Powered by HTML5 Canvas technology for instant downloads without server latency.</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
